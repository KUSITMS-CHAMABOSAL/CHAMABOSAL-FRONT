# 복사해서 .env 로 만들어 써요. .env 는 커밋하지 않아요.
# VITE_ 값은 번들에 그대로 들어가니 비밀값을 넣지 않아요.

# API 서버 주소. 로그인만 이 서버로 가고 나머지 API는 목이에요. 운영 빌드에는 꼭 넣어요.
VITE_API_BASE_URL=

# 개발 서버에서 실서버에 붙을 때만 써요. 있으면 익명 키 로그인 대신 테스트 토큰으로 로그인해요. 운영 빌드에서는 무시돼요.
# 키는 서버 비밀값이라 백엔드에 받아 .env 에만 넣어요.
VITE_TEST_TOKEN_KEY=
# 테스트 사용자 이름. 영문 소문자·숫자 1~8자
VITE_TEST_USER=tester1
